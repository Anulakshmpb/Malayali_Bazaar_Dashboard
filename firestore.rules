rules_version = '2';

// Cloud Firestore Security Rules for malayali-bazaar (named "default" database)
// Note: Prototype hardened rules — review and test with Firebase Emulator Suite
// before deploying to production.
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // Helper Functions
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdminRecordActive(adminData) {
      return !('status' in adminData) || adminData.status == 'active';
    }

    // Active admin via adminUsers record (authoritative when present) or admin custom claim
    function isAdmin() {
      return isAuthenticated() && (
        (
          exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)) &&
          isAdminRecordActive(get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data)
        ) ||
        (
          !exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)) &&
          request.auth.token.admin == true
        )
      );
    }

    function isValidSelfUserCreate(userId) {
      return (!('uid' in request.resource.data) || request.resource.data.uid == userId) &&
        (!('isActive' in request.resource.data) || request.resource.data.isActive == true) &&
        !request.resource.data.keys().hasAny([
          'isBlocked',
          'role',
          'usedPromoCodesCount',
          'promoCodeUsage',
          'usedPromoCodes',
          'lastPromoUsed'
        ]);
    }

    function areProtectedUserFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'uid',
        'isActive',
        'isBlocked',
        'role',
        'usedPromoCodesCount',
        'promoCodeUsage',
        'usedPromoCodes',
        'lastPromoUsed',
        'createdAt'
      ]);
    }

    // ==========================================
    // Public Storefront & Catalog Collections
    // ==========================================
    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /brand/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /brands/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /category/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subCategory/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /productTypes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /product_test/{id} {
      allow read, write: if isAdmin();
    }

    match /sections/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /schemes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /delivery_settings/{id} {
      allow read: if true;
      allow write: if isAdmin();

      match /{document=**} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /deliveryCharges/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /delivery_places/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /deliveryPlaces/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /places/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /websiteManagement/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==========================================
    // Admin & Permissions Management (Restricted)
    // ==========================================
    match /permissions/{id} {
      allow read, write: if isAdmin();
    }

    match /adminUsers/{id} {
      // Admins can read all admin records; authenticated users can read only their own lookup record
      allow read: if isAdmin() || (
        isAuthenticated() &&
        (request.auth.uid == id || resource.data.uid == request.auth.uid)
      );
      allow write: if isAdmin();
    }

    // ==========================================
    // Promocodes (Server-validated via placeOrder & validatePromoCode)
    // ==========================================
    match /promocodes/{id} {
      allow read, write: if isAdmin();

      match /{document=**} {
        allow read, write: if isAdmin();
      }
    }

    // ==========================================
    // Notifications & Templates
    // ==========================================
    match /admin_notification/{id} {
      allow read, write: if isAdmin();
    }

    match /notification_templates/{id} {
      allow read, write: if isAdmin();
    }

    match /_notificationCampaigns/{id} {
      allow read, write: if isAdmin();
    }

    // ==========================================
    // Analytics & Financial Reporting Collections
    // ==========================================
    match /analytics/{id} {
      allow read, write: if isAdmin();

      match /{document=**} {
        allow read, write: if isAdmin();
      }
    }

    match /analytics_time_series/{id} {
      allow read, write: if isAdmin();

      match /{document=**} {
        allow read, write: if isAdmin();
      }
    }

    match /analytics_products/{id} {
      allow read, write: if isAdmin();

      match /{document=**} {
        allow read, write: if isAdmin();
      }
    }

    match /user_ledgers/{id} {
      allow read, write: if isAdmin();

      match /{document=**} {
        allow read, write: if isAdmin();
      }
    }

    match /ledger_payments/{id} {
      allow read, write: if isAdmin();
    }

    match /configurations/{id} {
      allow read, write: if isAdmin();
    }

    match /counters/{id} {
      allow read, write: if isAdmin();
    }

    // ==========================================
    // Orders (Created via placeOrder Cloud Function; Admins manage status)
    // ==========================================
    match /orders/{orderId} {
      allow read: if isAdmin() || (
        isAuthenticated() &&
        (resource.data.userId == request.auth.uid || resource.data.customerId == request.auth.uid)
      );
      allow create, update, delete: if isAdmin();

      match /{document=**} {
        allow read, write: if isAdmin();
      }
    }

    // ==========================================
    // Users: own profile & safe subcollections
    // ==========================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin() || (isOwner(userId) && isValidSelfUserCreate(userId));
      allow update: if isAdmin() || (isOwner(userId) && areProtectedUserFieldsUnchanged());
      allow delete: if isAdmin();

      match /used_promocodes/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }

      match /notifications/{notifId} {
        allow read: if isOwner(userId) || isAdmin();
        allow update: if isAdmin() || (
          isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'read', 'readAt'])
        );
        allow create, delete: if isAdmin();
      }

      match /{subcollection}/{document=**} {
        allow read, write: if (subcollection != 'used_promocodes' && subcollection != 'notifications' && isOwner(userId)) || isAdmin();
      }
    }

    // ==========================================
    // Deny everything else by default
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
